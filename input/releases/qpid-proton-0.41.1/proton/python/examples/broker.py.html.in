                    <span class="n">Endpoint</span><span class="p">,</span> <span class="n">Link</span><span class="p">,</span> <span class="n">Sender</span><span class="p">,</span> <span class="n">Message</span><span class="p">,</span> <span class="n">Terminus</span><span class="p">,</span> <span class="n">DeclaredDisposition</span><span class="p">,</span>
                    <span class="n">RejectedDisposition</span><span class="p">,</span> <span class="n">TransactionalDisposition</span><span class="p">)</span>
